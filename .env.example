# Copy to .env and adjust. Every variable uses the UPA_ prefix.

# development | test | production
UPA_ENVIRONMENT=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG
UPA_LOG_LEVEL=INFO

# SQLAlchemy async URL. PostgreSQL only. Create the role and database first
# with scripts/setup-db.sql, then set the password you chose here.
UPA_DATABASE_URL=postgresql+asyncpg://upa:change-me@localhost:5432/upa_dev
UPA_DATABASE_ECHO=false

# Optional. Server the test suite creates throwaway databases on.
# Defaults to UPA_DATABASE_URL when unset.
# UPA_TEST_DATABASE_URL=postgresql+asyncpg://upa:change-me@localhost:5432/upa_dev

# Where stored samples live. Never commit this directory.
UPA_STORAGE_ROOT=var/samples

# local | memory  (memory is for tests only - nothing is persisted)
UPA_STORAGE_BACKEND=local

# Base64-encoded 32-byte key used to encrypt stored samples.
# REQUIRED when UPA_ENVIRONMENT=production. Left unset in development, a fixed
# key derived from a constant in the source is used instead - that key is public
# by definition, which is why production refuses to start without a real one.
# Generate one with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# UPA_SAMPLE_ENCRYPTION_KEY=
UPA_SAMPLE_ENCRYPTION_KEY_ID=dev

# Largest accepted upload, in bytes. Default is 100 MiB.
UPA_MAX_UPLOAD_BYTES=104857600

# How long a worker owns a claimed job before the lease lapses and the reaper
# may take it back. Must comfortably exceed the heartbeat interval, or healthy
# workers lose jobs they are still working on.
UPA_JOB_LEASE_SECONDS=300

# How many times a job may be handed out before it is cancelled. Without a
# limit, a job that kills every worker it touches is retried forever.
UPA_JOB_MAX_ATTEMPTS=3

# How often the reaper looks for lapsed leases.
UPA_REAPER_INTERVAL_SECONDS=30

# How long a worker waits before asking for work again when the queue is empty.
UPA_WORKER_POLL_SECONDS=2

# Requests allowed per API key per minute, refilled continuously.
UPA_RATE_LIMIT_PER_MINUTE=120

# Largest burst a key may spend at once. Defaults to the per-minute rate.
# UPA_RATE_LIMIT_BURST=120

# If set, an API key with every scope is created at startup with this token.
# Development only - production refuses to start with this set, because a
# credential in an environment variable appears in process listings and
# orchestrator manifests and is identical on every instance. Issue real keys
# with:
#   python scripts/create-api-key.py --name ingest --scope submissions:write
# UPA_BOOTSTRAP_API_KEY=

# Prefix for versioned API routes.
UPA_API_PREFIX=/api/v1
